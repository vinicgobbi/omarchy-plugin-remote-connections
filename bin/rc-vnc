#!/bin/bash

# Share this screen over VNC with wayvnc, as a transient systemd user unit
# (so it survives an omarchy-shell restart and stops cleanly).
#
#   rc-vnc start local|tailscale|lan <port> [control|view-only]
#   rc-vnc stop
#   rc-vnc disconnect <client-id>
#   rc-vnc disconnect-all
#
# Authentication is always on: user = your login name, password = the one
# saved in the keyring by the plugin (bin/rc-secret, id "host-vnc"). The
# config holding it is written to $XDG_RUNTIME_DIR (tmpfs, mode 0600) and
# deleted as soon as wayvnc has read it. Traffic is encrypted with RSA-AES
# or TLS (VeNCrypt), whichever the client picks; keys are generated once.

set -uo pipefail

# Logs, session records and run files hold hostnames and users: keep them
# private to this user.
umask 077

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
UNIT="omarchy-remote-wayvnc"
runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"
socket="$runtime/omarchy-remote-wayvnc.sock"
key_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-remote-connections/wayvnc"

die() {
  echo "$*" >&2
  exit 1
}

ensure_keys() {
  if ! mkdir -p "$key_dir" || ! chmod 700 "$key_dir"; then
    die "Couldn't create $key_dir"
  fi
  if [[ ! -s $key_dir/rsa_key.pem ]]; then
    ssh-keygen -q -m pem -t rsa -b 3072 -N "" -C "omarchy-remote-wayvnc" -f "$key_dir/rsa_key.pem" </dev/null >/dev/null \
      || die "Couldn't generate the RSA key"
    rm -f "$key_dir/rsa_key.pem.pub"
  fi
  if [[ ! -s $key_dir/tls_key.pem || ! -s $key_dir/tls_cert.pem ]]; then
    local host
    host=$(uname -n)
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 \
      -days 3650 -nodes -keyout "$key_dir/tls_key.pem" -out "$key_dir/tls_cert.pem" \
      -subj "/CN=$host" -addext "subjectAltName=DNS:$host,DNS:localhost,IP:127.0.0.1" >/dev/null 2>&1 \
      || die "Couldn't generate the TLS certificate"
  fi
  chmod 600 "$key_dir"/*.pem
}

action=${1:-}

case "$action" in
  start)
    scope=${2:-}
    port=${3:-5900}
    if ! [[ $port =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
      die "invalid port: $port"
    fi
    command -v wayvnc >/dev/null 2>&1 || die "wayvnc isn't installed"

    case "$scope" in
      local) address=127.0.0.1 ;;
      tailscale)
        address=$(tailscale ip -4 2>/dev/null | head -n1)
        [[ -n $address ]] || die "Tailscale isn't connected, so there's no Tailscale address to share on."
        ;;
      lan) address=0.0.0.0 ;;
      *) die "scope must be local, tailscale or lan" ;;
    esac

    password=$("$here/rc-secret" get host-vnc 2>/dev/null) \
      || die "No screen-sharing password saved (or the keyring is locked)."
    [[ -n $password && $password != *$'\n'* ]] || die "The saved screen-sharing password is empty or has a line break."

    input_flag=()
    case "${4:-control}" in
      control) ;;
      view-only) input_flag=(--disable-input) ;;
      *) die "input mode must be control or view-only" ;;
    esac

    ensure_keys
    systemctl --user stop "$UNIT.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$UNIT.service" >/dev/null 2>&1 || true

    umask 077
    config_dir="$runtime/omarchy-remote-connections"
    mkdir -p "$config_dir" || die "Couldn't create $config_dir"
    config="$config_dir/wayvnc.conf"
    {
      echo "address=$address"
      echo "port=$port"
      echo "enable_auth=true"
      echo "username=${USER:-$(id -un)}"
      echo "password=$password"
      echo "rsa_private_key_file=$key_dir/rsa_key.pem"
      echo "private_key_file=$key_dir/tls_key.pem"
      echo "certificate_file=$key_dir/tls_cert.pem"
    } >"$config"
    unset password

    # A socket left by an earlier run would look like this one already being
    # up (and the config would be deleted before wayvnc read it).
    rm -f "$socket"
    since=$(date '+%Y-%m-%d %H:%M:%S')

    systemd-run --user --quiet --collect --unit="$UNIT" \
      --description="Omarchy Remote Connections: screen sharing (wayvnc)" \
      --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
      --setenv=XDG_RUNTIME_DIR="$runtime" \
      wayvnc --config="$config" --socket="$socket" --render-cursor "${input_flag[@]}" \
      || { rm -f "$config"; die "Couldn't start wayvnc"; }

    # It's up only once it listens on the port: by then it has read the
    # config, so the password can leave the disk. If it exits first, report
    # why instead of claiming success.
    listening=false
    for _ in $(seq 1 40); do
      systemctl --user is-active --quiet "$UNIT.service" || break
      if ss -ltnpH "sport = :$port" 2>/dev/null | grep -q "\"wayvnc\""; then
        listening=true
        break
      fi
      sleep 0.25
    done
    rm -f "$config"
    if ! $listening; then
      systemctl --user stop "$UNIT.service" >/dev/null 2>&1 || true
      reason=$(journalctl --user -u "$UNIT.service" --since "$since" --no-pager -o cat 2>/dev/null \
        | grep -iE 'error|fail|unable|cannot|could not' | grep -v 'Failed with result' | tail -n 2)
      die "Screen sharing didn't start${reason:+: $reason}"
    fi
    ;;

  stop)
    systemctl --user stop "$UNIT.service" >/dev/null 2>&1 || true
    rm -f "$runtime/omarchy-remote-connections/wayvnc.conf"
    ;;

  disconnect)
    id=${2:-}
    [[ $id =~ ^(0x)?[0-9a-fA-F]+$ ]] || die "invalid client id: $id"
    [[ -S $socket ]] || exit 0
    wayvncctl -S "$socket" client-disconnect "$id" >/dev/null
    ;;

  disconnect-all)
    [[ -S $socket ]] || exit 0
    while read -r id; do
      [[ -n $id ]] && wayvncctl -S "$socket" client-disconnect "$id" >/dev/null
    done < <(wayvncctl -S "$socket" --json client-list 2>/dev/null | jq -r 'if type == "array" then .[].id else empty end')
    ;;

  *)
    die "usage: rc-vnc start local|tailscale|lan <port> [control|view-only] | stop | disconnect <id> | disconnect-all"
    ;;
esac

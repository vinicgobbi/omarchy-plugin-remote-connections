#!/bin/bash

# Unprivileged snapshot of "This machine" for the bar widget, one
# `key<TAB>value` per line. Polled while the popup is open, so it only reads
# world-readable state and never touches the keyring (a locked keyring would
# otherwise prompt on every poll).

set -uo pipefail

TAG="omarchy-remote-connections"
UNIT="omarchy-remote-wayvnc.service"
DROPIN="/etc/ssh/sshd_config.d/90-omarchy-remote-connections.conf"
socket="${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-remote-wayvnc.sock"

out() { printf '%s\t%s\n' "$1" "$2"; }
yesno() { if "$@" >/dev/null 2>&1; then echo yes; else echo no; fi; }

hex() { printf '%s' "$1" | od -An -tx1 | tr -d ' \n'; }

# Scope of the firewall rule this plugin added for <what>: lan, tailscale or
# none. ufw stores rule comments hex-encoded in its (world-readable) rules.
fw_scope() {
  local comment tuples
  comment="comment=$(hex "$TAG $1")"
  tuples=$(grep -h '^### tuple ###' /etc/ufw/user.rules /etc/ufw/user6.rules 2>/dev/null | grep -F "$comment")
  if [[ -z $tuples ]]; then
    echo none
  elif grep -q 'in_tailscale0' <<<"$tuples"; then
    echo tailscale
  else
    echo lan
  fi
}

# --- SSH server ---
out ssh_installed "$(yesno command -v sshd)"
out ssh_active "$(systemctl is-active sshd.service 2>/dev/null || true)"
out ssh_enabled "$(systemctl is-enabled sshd.service 2>/dev/null || true)"
out ssh_keys_only "$(yesno test -f "$DROPIN")"
out ssh_firewall "$(fw_scope ssh)"
keys=$(grep -cE '^[[:space:]]*[^#[:space:]]' "$HOME/.ssh/authorized_keys" 2>/dev/null || true)
out authorized_keys "${keys:-0}"
ssh_port=$(cat /etc/ssh/sshd_config.d/*.conf /etc/ssh/sshd_config 2>/dev/null \
  | awk 'tolower($1) == "port" && $2 ~ /^[0-9]+$/ { print $2; exit }')
out ssh_port "${ssh_port:-22}"

# --- Firewall / network ---
ufw_enabled=no
grep -qE '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null && ufw_enabled=yes
out ufw_enabled "$ufw_enabled"
out lan_ips "$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|br-|veth|virbr|tailscale)/ { sub(/\/.*/, "", $4); print $4 }' | paste -sd, -)"
out tailscale_ip "$(tailscale ip -4 2>/dev/null | head -n1)"
out user "${USER:-$(id -un)}"

# --- Screen sharing (wayvnc) ---
out wayvnc_installed "$(yesno command -v wayvnc)"
out vnc_active "$(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
out vnc_firewall "$(fw_scope vnc)"
clients=""
if [[ -S $socket ]] && command -v wayvncctl >/dev/null 2>&1; then
  clients=$(wayvncctl -S "$socket" --json client-list 2>/dev/null \
    | jq -r 'if type == "array" then .[] | "\(.id)=\(.address // "unknown")" else empty end' 2>/dev/null \
    | paste -sd, -)
fi
# "id=address" per viewer, comma-separated.
out vnc_clients "$clients"

#!/bin/bash

# Plan the system changes for one or more actions, without running anything.
# Nothing here needs root: it only reads world-readable state and prints the
# plan, one line per item:
#
#   <mode><TAB><description><TAB><command>   a step; mode is
#       root         runs as administrator (the review sheet elevates the
#                    whole batch once with pkexec; the terminal with sudo)
#       user         runs as you
#       interactive  needs a terminal (asks for a passphrase, a remote
#                    password…), so it can only run in the terminal
#   #after<TAB><text>      what's true once it ran
#   #undo<TAB><text>       how to reverse it, in words
#   #reverse<TAB><action>  the action (as rc-steps arguments) that reverses it
#
# The command is exactly what's shown and then run through `bash -c`.
#
#   rc-steps <action> [args...] [+ <action> [args...]]...
#
# Actions:
#   install <package>...          omarchy pkg add ...
#   remove <package>...           omarchy pkg drop ...
#   ssh-key-setup [user@]host [port]   create a key if needed, ssh-copy-id it

set -uo pipefail

PKG_RE='^[a-z0-9][a-z0-9+._-]*$'

die() {
  echo "$*" >&2
  exit 1
}

root() { printf 'root\t%s\t%s\n' "$1" "$2"; }
user() { printf 'user\t%s\t%s\n' "$1" "$2"; }
interactive() { printf 'interactive\t%s\t%s\n' "$1" "$2"; }
after() { printf '#after\t%s\n' "$1"; }
undo() { printf '#undo\t%s\n' "$1"; }
reverse() { printf '#reverse\t%s\n' "$*"; }

check_port() {
  if ! [[ $1 =~ ^[0-9]+$ ]] || (( $1 < 1 || $1 > 65535 )); then
    die "invalid port: $1"
  fi
}

check_packages() {
  (( $# > 0 )) || die "no packages given"
  local pkg
  for pkg in "$@"; do
    [[ $pkg =~ $PKG_RE ]] || die "invalid package name: $pkg"
  done
}

plan() {
  local action=${1:-}
  shift || true
  case "$action" in
    install)
      check_packages "$@"
      root "Install $* with Omarchy's package installer (only what's missing)" "omarchy pkg add $*"
      after "$* installed"
      undo "Remove it again from Setup"
      reverse remove "$@"
      ;;

    remove)
      check_packages "$@"
      root "Remove $* (and the dependencies nothing else uses)" "omarchy pkg drop $*"
      after "$* removed; features that need it show Install again"
      undo "Install it again from Setup"
      reverse install "$@"
      ;;

    ssh-key-setup)
      # The key path stays a literal ~/…: it's shown to the user, and the
      # `bash -c` that runs the step expands it.
      local target=${1:-} port=${2:-} key="" candidate
      [[ $target =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9._:-]+$ && $target != -* ]] \
        || die "ssh-key-setup: invalid target: $target"
      [[ -z $port ]] || check_port "$port"
      for candidate in id_ed25519 id_ecdsa id_rsa; do
        if [[ -f $HOME/.ssh/$candidate && -f $HOME/.ssh/$candidate.pub ]]; then
          # shellcheck disable=SC2088
          key="~/.ssh/$candidate"
          break
        fi
      done
      if [[ -z $key ]]; then
        # shellcheck disable=SC2088
        key="~/.ssh/id_ed25519"
        interactive "Create a new SSH key (it asks for an optional passphrase)" \
          "ssh-keygen -t ed25519 -f $key -C \"\$USER@\$(uname -n)\""
      fi
      interactive "Copy your public key to $target (asks for its password once)" \
        "ssh-copy-id -i $key.pub${port:+ -p $port} $target"
      after "You log in to $target with your key ($key) instead of its password"
      undo "On $target, delete the line with your key from ~/.ssh/authorized_keys"
      ;;

    *)
      die "unknown action: $action"
      ;;
  esac
}

# Split the arguments on "+" and plan each action in turn.
args=()
for arg in "$@" +; do
  if [[ $arg == + ]]; then
    (( ${#args[@]} > 0 )) && { plan "${args[@]}" || exit 1; }
    args=()
  else
    args+=("$arg")
  fi
done

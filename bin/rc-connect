#!/bin/bash

# Open one saved connection. The bar widget runs it through `uwsm-app` so
# the client lives in its own systemd unit and survives an omarchy-shell
# restart. The connection comes as JSON (no secrets in it — see
# Model.connectPayload):
#
#   rc-connect '<json>'
#
# Passwords come from the keyring (bin/rc-secret) and never reach argv:
# FreeRDP reads its whole command line from stdin (/args-from:stdin) and
# TigerVNC reads VNC_USERNAME/VNC_PASSWORD from its own environment.

set -uo pipefail

# Logs, session records and run files hold hostnames and users: keep them
# private to this user.
umask 077

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-remote-connections"
session_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-remote-connections/sessions"

notify() {
  notify-send -a "Remote Connections" -i network-server "$@" 2>/dev/null || true
}

fail() {
  notify -u critical "Couldn't connect" "$1"
  echo "$1" >&2
  exit 1
}

conn=${1:-}
[[ -n $conn ]] || fail "rc-connect: missing connection JSON"

# Prints the value, or nothing when it's missing. (Not `// empty`: jq's
# alternative operator also swallows `false`.)
field() { jq -r "$1 | if . == null then empty else . end" <<<"$conn"; }

id=$(field .id)
name=$(field .name)
protocol=$(field .protocol)
host=$(field .host)
port=$(field .port)
user=$(field .user)
has_secret=$(field .hasSecret)

[[ -n $host ]] || fail "Connection has no host"

# connections.json can be edited by hand or come from someone else, so
# everything that ends up on a client's command line is checked again here
# (Model.validate does the same for the form):
# - a host starting with "-" would be read as an option; TigerVNC also
#   treats any "Name=value" argument as a setting (e.g. Via=… would tunnel
#   through another machine), hence no "=" either;
# - FreeRDP reads one argument per line, so no field may hold a line break;
# - ssh's user/jump host get the same strict shape as hostnames.
HOST_RE='^[A-Za-z0-9_][A-Za-z0-9._:-]*$'
[[ $host =~ $HOST_RE ]] || fail "Invalid host \"$host\" (letters, digits, . _ : - only)."
[[ -z $port || ( $port =~ ^[0-9]{1,5}$ && $port -ge 1 && $port -le 65535 ) ]] || fail "Invalid port: $port"
for value in "$name" "$user" "$(field .rdp.domain)" "$(field .identityFile)"; do
  [[ $value != *[[:cntrl:]]* ]] || fail "A field of \"${name//[[:cntrl:]]/}\" contains control characters."
done
[[ $user != -* ]] || fail "User can't start with '-'"

password=""
if [[ $has_secret == "true" && $protocol != "ssh" ]]; then
  password=$("$here/rc-secret" get "$id" 2>/dev/null) || {
    notify "Keyring locked or password missing" "$name: the client will ask for the password."
    password=""
  }
  if [[ $password == *$'\n'* ]]; then
    fail "Stored password for $name contains a line break, which the RDP/VNC clients can't take."
  fi
fi

first_available() {
  local bin
  for bin in "$@"; do
    if command -v "$bin" >/dev/null 2>&1; then
      echo "$bin"
      return 0
    fi
  done
  return 1
}

# Run a GUI client, keeping its output in a per-protocol log and reporting
# a failed exit (bad password, unreachable host, rejected certificate...).
# While it runs it's listed as an active session (bin/rc-sessions), so the
# popup can show it with Show/Disconnect even if the window holds the
# keyboard.
run_client() {
  mkdir -p "$log_dir" "$session_dir" && chmod 700 "$log_dir"
  local log="$log_dir/last-$protocol.log" pid status
  # Explicit stdin: a background job would otherwise get /dev/null, and
  # FreeRDP reads its arguments from stdin.
  "$@" 0<&0 >"$log" 2>&1 &
  pid=$!
  printf '%s\t%s\t%s\t%s\n' "$pid" "$protocol" "$(date +%s%3N)" "$name" >"$session_dir/$id"
  wait "$pid"
  status=$?
  rm -f "$session_dir/$id"
  # FreeRDP exits with 12/13 (logoff/disconnect by user) on a normal close;
  # 143 is our own Disconnect (SIGTERM from bin/rc-sessions).
  if (( status != 0 && status != 12 && status != 13 && status != 143 )); then
    notify -u critical "$name: connection ended with an error" "Exit code $status. Details: $log"
  fi
  return "$status"
}

case "$protocol" in
  ssh)
    args=(ssh)
    [[ -n $port && $port != 22 ]] && args+=(-p "$port")
    identity=$(field .identityFile)
    jump=$(field .jumpHost)
    [[ -z $user || $user =~ ^[A-Za-z0-9._][A-Za-z0-9._@-]*$ ]] || fail "Invalid SSH user: $user"
    # -J takes user@host[:port], comma-separated for several hops.
    [[ -z $jump || $jump =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9_][A-Za-z0-9._-]*(:[0-9]+)?(,([A-Za-z0-9._-]+@)?[A-Za-z0-9_][A-Za-z0-9._-]*(:[0-9]+)?)*$ ]] \
      || fail "Invalid jump host: $jump"
    [[ -n $identity ]] && args+=(-i "${identity/#\~/$HOME}")
    [[ -n $jump ]] && args+=(-J "$jump")
    args+=(-- "${user:+$user@}$host")

    # Keep the terminal open when ssh fails so the error stays readable.
    # shellcheck disable=SC2016 # expanded by the inner bash -c, not here
    wrapper='"$@"; status=$?; if (( status != 0 )); then echo; read -rsn1 -p "ssh exited with $status — press any key to close"; fi'
    exec xdg-terminal-exec --app-id=org.omarchy.remote-connections \
      --title="SSH · $name" -e bash -c "$wrapper" rc-ssh "${args[@]}"
    ;;

  rdp)
    # xfreerdp3 draws the Windows-style connection bar (sdl-freerdp3 accepts
    # /floatbar but ignores it); sdl-freerdp3 is native Wayland.
    if [[ $(field .rdp.connectionBar) == "false" ]]; then
      client=$(first_available sdl-freerdp3 xfreerdp3)
    else
      client=$(first_available xfreerdp3 sdl-freerdp3)
    fi
    [[ -n $client ]] || fail "No RDP client found. Install the 'freerdp' package."
    domain=$(field .rdp.domain)
    args=(
      "/v:$host:${port:-3389}"
      "/t:$name"
      /dynamic-resolution
      /cert:tofu
    )
    [[ -n $user ]] && args+=("/u:$user")
    [[ -n $domain ]] && args+=("/d:$domain")
    [[ -n $password ]] && args+=("/p:$password")
    [[ $(field .rdp.clipboard) != "false" ]] && args+=(+clipboard)
    [[ $(field .rdp.multimon) == "true" ]] && args+=(/multimon)
    # By default Omarchy's own shortcuts (SUPER+W, workspaces…) keep working
    # while the window has focus; "grabKeyboard" sends them to the remote.
    [[ $(field .rdp.grabKeyboard) == "true" ]] || args+=(-grab-keyboard)
    # Always visible (window and fullscreen), hides on its own unless pinned.
    [[ $client == xfreerdp3 ]] && args+=("/floatbar:sticky:off,default:visible,show:always")

    if [[ $client == sdl-freerdp3 ]]; then
      notify "$name" "Right Shift + D disconnects · Right Shift + Enter toggles fullscreen · Right Shift + G grabs/frees the keyboard. Or use Disconnect in the Remote Connections popup."
    else
      notify "$name" "Use the bar at the top of the window to minimize or close it. Ctrl + Alt + Enter toggles fullscreen. You can also disconnect from the Remote Connections popup."
    fi

    printf '%s\n' "${args[@]}" | run_client "$client" /args-from:stdin
    ;;

  vnc)
    client=$(first_available vncviewer) || fail "No VNC client found. Install the 'tigervnc' package."
    args=()
    [[ $(field .vnc.viewOnly) == "true" ]] && args+=(-ViewOnly)
    args+=("$host::${port:-5900}")

    if [[ -n $password ]]; then
      export VNC_PASSWORD=$password
      [[ -n $user ]] && export VNC_USERNAME=$user
    fi
    notify "$name" "F8 opens the viewer menu (Exit viewer, fullscreen). Or use Disconnect in the Remote Connections popup."
    run_client "$client" "${args[@]}"
    ;;

  *)
    fail "Unknown protocol: $protocol"
    ;;
esac

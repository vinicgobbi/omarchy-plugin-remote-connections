#!/bin/bash

# Runs inside an Omarchy floating terminal (opened by bin/rc-terminal).
# Shows every command it's about to run, warns, and only proceeds once you
# choose to — all at once or one step at a time. The commands shown are
# exactly the ones executed.
#
#   rc-run-steps <token> <title> <action> [args...] [+ <action> ...]
#
# Writes the outcome to $XDG_RUNTIME_DIR/omarchy-remote-connections/run-<token>.result
# (ok | partial | canceled | failed<TAB>message) for the plugin to read.

set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
token=${1:?token}
title=${2:?title}
shift 2

run_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-remote-connections"
result_file="$run_dir/run-$token.result"
mkdir -p "$run_dir"
echo $$ >"$run_dir/run-$token.pid"

# Match the current Omarchy theme's gum colors.
# shellcheck disable=SC1091
source omarchy-restart-gum 2>/dev/null || true

result_written=false
write_result() {
  printf '%s\n' "$1" >"$result_file"
  result_written=true
}
# Closing the window or Ctrl+C before finishing counts as canceled.
trap '$result_written || write_result canceled' EXIT

have_gum() { command -v gum >/dev/null 2>&1; }

# Everything shown here must be exactly what runs, so no text may carry
# terminal control sequences (an escape code could redraw the screen and
# hide the real command). Displayed text is stripped of them; a command that
# contains any is refused outright (see below).
plain() { printf '%s' "$1" | tr -d '\000-\037\177'; }
title=$(plain "$title")

style() {
  if have_gum; then gum style "$@"; else printf '%s\n' "${@: -1}"; fi
}

close_prompt() {
  echo
  read -rsn1 -p "Press any key to close this window."
  echo
}

confirm() {
  if have_gum; then
    gum confirm --default=false --affirmative="Run it" --negative="Skip" "$1"
  else
    local answer
    read -rp "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
  fi
}

mapfile -t plan < <("$here/rc-steps" "$@" 2>"$run_dir/run-$token.err")
steps=()
afters=()
undos=()
uses_sudo=false
unsafe=false
for line in "${plan[@]}"; do
  [[ ${line#*$'\t'} == *[[:cntrl:]]* ]] && unsafe=true
  case "$line" in
    "#after"$'\t'*) afters+=("${line#*$'\t'}") ;;
    "#undo"$'\t'*) undos+=("${line#*$'\t'}") ;;
    *)
      steps+=("$line")
      [[ ${line#*$'\t'} == *sudo\ * ]] && uses_sudo=true
      ;;
  esac
done
if $unsafe; then
  echo "Refusing to continue: a step contains terminal control characters." >"$run_dir/run-$token.err"
fi
if [[ -s $run_dir/run-$token.err ]]; then
  message=$(plain "$(<"$run_dir/run-$token.err")")
  style --foreground 1 --bold "Can't continue: $message"
  write_result "failed	$message"
  close_prompt
  exit 1
fi
if (( ${#steps[@]} == 0 )); then
  style --bold "Nothing to change — this machine is already set up that way."
  write_result ok
  close_prompt
  exit 0
fi

clear
style --bold --foreground 212 "Remote Connections · $title"
echo
if (( ${#afters[@]} > 0 )); then
  style --bold "After this"
  for a in "${afters[@]}"; do echo "  • $(plain "$a")"; done
  echo
fi
if (( ${#undos[@]} > 0 )); then
  style --bold "To undo"
  for u in "${undos[@]}"; do echo "  • $(plain "$u")"; done
  echo
fi
style --bold "Commands (run exactly as shown)"
echo
i=0
for s in "${steps[@]}"; do
  i=$((i + 1))
  style --bold "$i. $(plain "${s%%$'\t'*}")"
  style --foreground 6 --padding "0 3" "\$ ${s#*$'\t'}"
done
echo
if $uses_sudo; then
  warning="⚠  These commands change your system (services, firewall, packages).
Only run them if you know what they do. Commands starting with sudo
will ask for your password."
else
  warning="⚠  These commands change files on this computer or on the server
you named. Only run them if you know what they do."
fi
style --border rounded --border-foreground 3 --foreground 3 --padding "0 1" --width 70 "$warning"
echo

if have_gum; then
  choice=$(gum choose --header "How do you want to continue?" \
    "Run all steps" "Confirm each step" "Cancel") || choice="Cancel"
else
  echo "1) Run all steps   2) Confirm each step   3) Cancel"
  read -rp "Choose [3]: " n
  case "$n" in 1) choice="Run all steps" ;; 2) choice="Confirm each step" ;; *) choice="Cancel" ;; esac
fi

if [[ $choice == Cancel ]]; then
  style --foreground 3 "Canceled — nothing was changed."
  write_result canceled
  sleep 1
  exit 0
fi

skipped=0
i=0
for s in "${steps[@]}"; do
  i=$((i + 1))
  desc=$(plain "${s%%$'\t'*}")
  cmd=${s#*$'\t'}
  echo
  style --bold "$i/${#steps[@]} · $desc"
  if [[ $choice == "Confirm each step" ]] && ! confirm "Run: $cmd"; then
    style --foreground 3 "   skipped"
    skipped=$((skipped + 1))
    continue
  fi
  style --foreground 6 "\$ $cmd"
  if ! bash -c "$cmd"; then
    style --foreground 1 --bold "Step $i failed. The steps after it were not run."
    write_result "failed	Step $i failed: $desc"
    close_prompt
    exit 1
  fi
done

echo
if (( skipped > 0 )); then
  style --foreground 3 --bold "Done, with $skipped step(s) skipped."
  write_result partial
else
  style --foreground 2 --bold "Done."
  write_result ok
fi
close_prompt

#!/bin/bash

# Store, look up and clear a connection's password in the GNOME keyring
# (via libsecret's secret-tool). Passwords never touch argv or the
# connections.json file: `set` reads the password as the first line of stdin.
#
#   rc-secret set <id> <name>    password on stdin
#   rc-secret get <id>           password on stdout, exit 1 if none
#   rc-secret clear <id>

set -uo pipefail

SERVICE="omarchy-remote-connections"

if ! command -v secret-tool >/dev/null 2>&1; then
  echo "secret-tool not found (install libsecret)" >&2
  exit 127
fi

action=${1:-}
id=${2:-}

if [[ -z $action || -z $id ]]; then
  echo "usage: rc-secret set|get|clear <id> [name]" >&2
  exit 2
fi

case "$action" in
  set)
    name=${3:-$id}
    IFS= read -r password || true
    if [[ -z $password ]]; then
      echo "empty password" >&2
      exit 2
    fi
    printf '%s' "$password" | secret-tool store --label="Remote connection: $name" service "$SERVICE" id "$id"
    ;;
  get)
    secret-tool lookup service "$SERVICE" id "$id"
    ;;
  clear)
    # secret-tool exits non-zero when there was nothing to clear; that's fine.
    secret-tool clear service "$SERVICE" id "$id" || true
    ;;
  *)
    echo "unknown action: $action" >&2
    exit 2
    ;;
esac
